{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.railway-demo",
    "watchPatterns": [
      "/backend/**",
      "/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/files/demo-health.txt",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2
  }
}
