# .env로 복사해서 사용. docker compose와 Spring(dev)이 같이 읽는다

# MySQL
DB_URL=jdbc:mysql://localhost:3306/backpack
DB_USERNAME=backpack
DB_PASSWORD=backpack
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# FCM 서비스 계정 키(JSON) 파일 경로. 비워 두면 푸시 발송이 꺼진다. 키 파일은 커밋하지 않는다
# FIREBASE_CREDENTIALS_PATH=./backpack-firebase-adminsdk.json

# 앱에 내려주는 이미지 주소의 앞부분. 기본값은 http://localhost:8080/files
# 안드로이드 에뮬레이터는 10.0.2.2, 실제 기기는 PC의 IP로 바꾼다
# STORAGE_PUBLIC_BASE_URL=http://10.0.2.2:8080/files

# JWT (HS256, 32바이트 이상, 필수). 아래 값은 로컬 전용 예시
# 운영 값은 `openssl rand -base64 48`로 따로 만들어 환경변수로 넣는다
JWT_SECRET=local-only-example-secret-change-me-0123456789

# 한국수출입은행 환율 API 인증키 (선택). 없으면 Frankfurter(ECB) → ExchangeRate-API 순으로 받는다
# EXIM_API_KEY=
# 외부 환율 API를 끄려면 false (DB에 쌓인 값만 쓴다)
# EXCHANGE_RATE_FETCH_ENABLED=true

# AI 일정 재구성 (선택). https://aistudio.google.com/apikey 에서 무료로 받는다. 없으면 규칙 기반 추천만 쓴다
# GEMINI_API_KEY=
# 구글 장소 검색 · 이동 시간 서버 키 (선택, 결제 계정 필요). 없으면 OpenStreetMap으로 찾는다
# GOOGLE_MAPS_API_KEY=
# 지도 공용 서버(OpenStreetMap)를 부르지 않으려면 false (직선거리 어림값만 쓴다)
# MAP_FETCH_ENABLED=true
